# Configuration FACTICE réservée aux tests (CI et environnements sans `.env`).
# Aucune valeur réelle ici : uniquement des valeurs bidon évidentes pour que
# `Settings()` s'instancie sans vrais secrets. Chargé par `tests/conftest.py`
# lorsqu'aucun vrai `.env` n'est présent (jamais en local si `.env` existe).

# configuration globale :
APP_NAME="Factur-IA Test"
ENVIRONNEMENT="test"
DEBUG="True"

# configuration de la bdd (bidon : aucun test ne se connecte à une vraie base) :
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="factur_ia_test"
DB_USER="test"
DB_PASSWORD="test-not-a-real-password"  # pragma: allowlist secret
DB_CHARSET="utf8mb4"

# configuration API :
API_PORT="8000"
API_HOST="localhost"

# sécurité (valeurs bidon, non sensibles) :
ACCESS_TOKEN_EXPIRE_MINUTES="30"
ALGORITHM="HS256"
SECRET_KEY="dummy-ci-secret-not-a-real-key"  # pragma: allowlist secret
SECRET_OCR_TOKEN="dummy-ci-ocr-not-a-real-token"  # pragma: allowlist secret

# clé Fernet FACTICE pour le chiffrement IBAN des tests (aucune donnée réelle) :
IBAN_ENCRYPTION_KEY="A9rWX6z0wtHbIXbcThwiLjOUSdRenb0yT5hzMKjMJxk="  # pragma: allowlist secret

# API IA d'extraction :
IA_API_BASE_URL="http://ia-api.invalid"

# clé de Luhn des SIRET : mode strict (défaut production) en CI ; les tests du
# mode relâché surchargent explicitement via monkeypatch.
SIRET_LUHN_STRICT="True"
