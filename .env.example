# configuration globale :
APP_NAME="Factur-IA API"
ENVIRONNEMENT="dev/test/prod"
DEBUG="True/False"

# configuration de la bdd
DB_HOST="host de la bdd"
DB_PORT="numéro de port de la bdd"
DB_NAME="nom de la bdd"
DB_USER="utilisateur"
DB_PASSWORD="mot de passe" # pragma: allowlist secret
DB_CHARSET="utf8"

# configuration API :
API_PORT="nulméro de port de l'API"
API_HOST="host de l'API"

ACCESS_TOKEN_EXPIRE_MINUTES="durée de validité du token en minutes"
ALGORITHM="algorithme de chiffrement du token (HS256, RS256, etc.)"
SECRET_KEY="ma clé secrete pour les tokens, à générer via bash avec : openssl rand -hex 32" # pragma: allowlist secret

SECRET_OCR_TOKEN="ma clé secrete pour l'ocr, à générer via bash avec : openssl rand -hex 32" # pragma: allowlist secret

# chiffrement des IBAN au repos (Fernet). Requise : sans clé, l'application ne démarre pas.
# ATTENTION : perdre cette clé rend les IBAN chiffrés en base définitivement irrécupérables
# (et le downgrade de la migration impossible). La sauvegarder au même titre que les
# credentials de la base. Elle doit être définie AVANT de lancer `alembic upgrade`.
IBAN_ENCRYPTION_KEY="clé Fernet, à générer via : uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'" # pragma: allowlist secret

# API IA d'extraction (OCR) :
IA_API_BASE_URL="URL de base de l'API IA (ex : http://localhost:8001)"

# Chorus Pro via PISTE — environnement de QUALIFICATION (sandbox).
# Optionnels : sans credentials, l'app démarre et la route de transmission répond 503.
# Passage en PRODUCTION : remplacer les 4 credentials par ceux de production et
# surcharger les URLs (CHORUS_OAUTH_URL=https://oauth.piste.gouv.fr/api/oauth/token,
# CHORUS_BASE_URL=https://api.piste.gouv.fr). Aucun changement de code.
CHORUS_PISTE_CLIENT_ID="client_id de l'application PISTE (sandbox)"
CHORUS_PISTE_CLIENT_SECRET="client_secret de l'application PISTE (sandbox)" # pragma: allowlist secret
CHORUS_TECH_LOGIN="login du compte technique Chorus Pro (ex : TECH_1_xxx@cpro.fr)"
CHORUS_TECH_PASSWORD="mot de passe du compte technique Chorus Pro" # pragma: allowlist secret
CHORUS_OAUTH_URL="https://sandbox-oauth.piste.gouv.fr/api/oauth/token"
CHORUS_BASE_URL="https://sandbox-api.piste.gouv.fr"

# Clé de Luhn des SIRET (conformité Factur-X). True (défaut, OBLIGATOIRE en
# production) : clé invalide = erreur bloquante. False : clé invalide = simple
# avertissement — réservé à la sandbox/qualification Chorus Pro, dont les SIRET
# fictifs ne respectent pas la clé de contrôle. Le format (14 chiffres) reste
# bloquant dans les deux modes.
SIRET_LUHN_STRICT="True"

# réinitialisation de mot de passe (valeurs par défaut fournies dans le code) :
RESET_TOKEN_EXPIRE_HOURS="durée de validité du lien de reset en heures (ex : 2)"
FRONTEND_RESET_URL="URL de la page front de reset (ex : https://app.exemple.fr/reinitialiser-mot-de-passe)"
EMAIL_SENDER="adresse expéditeur des emails transactionnels (ex : no-reply@factur-ia.fr)"

# admin plateforme (seed du compte racine ; si absents, le seed est ignoré) :
PLATFORM_ADMIN_EMAIL="email du premier admin plateforme (ex : admin@factur-ia.fr)"
PLATFORM_ADMIN_PASSWORD="mot de passe du premier admin plateforme" # pragma: allowlist secret
PLATFORM_ADMIN_NOM="nom du premier admin plateforme"
PLATFORM_ADMIN_PRENOM="prénom du premier admin plateforme"
